<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Quello che serve a GdANav sul telefono, in qualunque app stia: si
         unisce da solo al manifesto di chi lo porta dentro (l'app GdANav,
         GdAHome). Android Auto invece lo dichiara l'app. -->
    <!-- Mappe, percorsi, relay di Home Assistant. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sapere se la rete si paga a consumo: gli edifici della scena 3D (un
         pacchetto per zona, anche cento megabyte) si scaricano solo su una
         rete che non costa (`stato/gestore_edifici.dart`). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- La posizione per navigare. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Il dongle OBD Bluetooth: solo per parlarci, non per localizzare. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- La notifica di navigazione con la prossima manovra (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- In auto col telefono in tasca: il servizio in primo piano che tiene
         accesa la posizione finché GdANav è sullo schermo dell'auto
         (`auto/PosizioneInAuto.kt`). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- La musica di casa che suona nel telefono in auto
         (`musica/ServizioLettoreDiCasa.kt`): il servizio in primo piano
         mentre suona, e il telefono sveglio quanto basta a leggere il flusso
         della radio con lo schermo spento. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <queries>
        <!-- La voce della guida: la sintesi vocale del telefono. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Far partire la musica da zero (`musica/AvvioMusica.kt`): da
             Android 11 si vedono solo le app dichiarate qui. Chi offre un
             MediaBrowserService (Spotify, YouTube Music…: l'elenco «App
             della musica» e il collegamento pulito), chi riceve i tasti
             multimediali (▶ mandato all'app), e Spotify per nome (il nome,
             l'icona e, solo sul telefono da fermi, aprirla). Si uniscono da
             sole al manifesto dell'app che porta GdANav dentro. -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
        <package android:name="com.spotify.music" />
    </queries>
    <application>
        <service
            android:name="it.gdanav.gdanav_app.auto.PosizioneInAuto"
            android:exported="false"
            android:foregroundServiceType="location" />
        <!-- La scena 3D dell'auto in un processo suo: la plancia aperta sul
             telefono non le toglie il motore web (vedi Scena3dServizio). -->
        <service
            android:name="it.gdanav.gdanav_app.auto.Scena3dServizio"
            android:exported="false"
            android:process=":mappa3d" />
        <!-- La musica nel navigatore (`musica/LettoreTelefono.kt`), in guida
             e a mappa libera: Android lascia vedere i lettori delle altre app
             (Spotify, YouTube Music…) solo a chi ha «Accesso alle notifiche».
             Il servizio non legge le notifiche: è solo la chiave. Lo accende
             l'utente, dopo la spiegazione nell'app (o dalla notifica che
             compare quando in auto manca). Nell'elenco del sistema si chiama
             «GdANav: musica», anche dentro GdAHome. Nessun android:process:
             sta nel processo dell'app, con lo schermo dell'auto. -->
        <!-- La musica di casa in auto: ExoPlayer con la sua sessione media3
             (notifica, focus audio, tasti del volante e delle cuffie). Si
             sfoglia (le radio di casa nella musica di Android Auto) solo da
             GdANav, Android Auto e il sistema: lo controlla il servizio. -->
        <service
            android:name="it.gdanav.gdanav_app.musica.ServizioLettoreDiCasa"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:label="Musica di casa">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <service
            android:name="it.gdanav.gdanav_app.musica.AscoltoNotifiche"
            android:exported="true"
            android:label="GdANav: musica"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
